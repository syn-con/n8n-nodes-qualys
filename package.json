{
  "name": "@syn-con/n8n-nodes-qualys",
  "version": "1.1.1",
  "description": "n8n community node for Qualys VMDR OT",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "qualys",
    "vmdr",
    "ot",
    "security"
  ],
  "license": "MIT",
  "author": {
    "name": "UAB Synergy",
    "email": "support@synergy.eu"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-icons.cjs",
    "dev": "tsc --watch",
    "format": "prettier --write README.md package.json tsconfig.json eslint.config.mjs index.ts scripts credentials nodes tests",
    "lint": "eslint credentials nodes scripts index.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/QualysVmdrOtApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Qualys/Qualys.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.36.0",
    "globals": "^16.3.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.45.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
