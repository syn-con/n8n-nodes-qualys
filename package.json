{
  "name": "@syn-con/n8n-nodes-qualys",
  "version": "2.0.5",
  "description": "n8n community node for Qualys VMDR, VMDR OT and CyberSecurity Asset Management",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "qualys",
    "vmdr",
    "csam",
    "asset-inventory",
    "vulnerability-management",
    "ot",
    "security"
  ],
  "license": "MIT",
  "author": {
    "name": "UAB Synergy",
    "email": "support@synergy.eu"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier --write README.md package.json tsconfig.json eslint.config.mjs index.ts credentials nodes tests",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-branches=90 --test-coverage-lines=90 --test-coverage-functions=90 tests/*.test.cjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/QualysVmdrOtApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Qualys/QualysVmdrOt.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@n8n/node-cli": "^0.45.6",
    "@types/node": "^24.3.1",
    "eslint": "^9.36.0",
    "globals": "^16.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.45.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  },
  "homepage": "https://github.com/syn-con/n8n-qualys#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/syn-con/n8n-qualys.git"
  }
}
